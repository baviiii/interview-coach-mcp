# ── Server ────────────────────────────────────────────────────────────────
PORT=8787
# Allowed browser origin for the web app (Vite dev server runs on 8080).
CORS_ORIGIN=http://localhost:8080
# Set NODE_ENV=production on a real deploy. The server refuses to boot with
# AUTH_MODE=dev in production, and warns if CORS_ORIGIN is left at "*".
#NODE_ENV=production

# ── Cost/abuse guards ───────────────────────────────────────────────────────
# Every /mcp and /api request can fan out to research sources plus a paid LLM
# call, so the rate limit is a spend cap as much as an abuse guard. Applied
# per bearer token (hashed) or client IP, fixed window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Hard cap on every model call — a hung upstream otherwise hangs the request.
LLM_TIMEOUT_MS=60000

# ── Supabase (CareerCraft's project — used for auth verification + RLS reads) ─
# The MCP server NEVER holds model keys. It only reads/writes the interview &
# study domain tables, scoped to the calling user via their forwarded JWT.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: only for service-role maintenance tasks (not used on the hot path).
SUPABASE_SERVICE_ROLE_KEY=

# ── Model provider (the ONLY path to a model) ──────────────────────────────
# mock    → no external calls; deterministic canned inference (great for dev).
# http    → calls a real Horus deployment.
# gateway → calls an OpenAI-compatible chat-completions gateway directly
#           (the same gateway CareerCraft's interview-ai edge function uses).
#           This is the real, no-mock generation path.
# For CareerCraft local dev with the web app, use gateway + hn (see README "Run it with CareerCraft").
HORUS_MODE=mock
HORUS_TENANT=careercraft
HORUS_BASE_URL=
HORUS_API_KEY=
# Maps onto what Horus already exposes today (rag-metadata / graph-query).
HORUS_RAG_URL=
HORUS_GRAPH_URL=

# ── Gateway provider (used when HORUS_MODE=gateway) ─────────────────────────
# MODEL_GATEWAY_KEY is your existing LOVABLE_API_KEY (usable from Node).
MODEL_GATEWAY_URL=https://ai.gateway.lovable.dev/v1/chat/completions
MODEL_GATEWAY_KEY=
MODEL_FAST=google/gemini-2.5-flash
MODEL_DEEP=google/gemini-2.5-flash

# ── Grounding (the proof layer behind tips & resources) ─────────────────────
# hn   → REAL Hacker News (Algolia) sources — no API key needed. Recommended.
# mock → canned proven sources (dev only).
# http → a grounding bridge (Reddit MCP + web-search MCP + Horus RAG).
GROUNDING_MODE=hn
GROUNDING_BASE_URL=
GROUNDING_API_KEY=

# ── Research (real, cited field material BEFORE generating) ─────────────────
# auto   → all free keyless sources (Reddit + Hacker News + Wikipedia + your
#          Horus RAG when available). The default — the career-agnostic engine.
# reddit → Reddit only.  mock → offline canned.  off → pre-research behavior.
RESEARCH_MODE=auto
# Free Reddit app credentials (reddit.com/prefs/apps). Strongly recommended on
# any cloud host: anonymous reddit.com/search.json 403s from datacenter IPs,
# so without these Reddit research silently drops out. Still $0.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#REDDIT_USER_AGENT=interview-coach-mcp/0.2 (career interview research)
