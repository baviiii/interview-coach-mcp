# ── Server ────────────────────────────────────────────────────────────────
PORT=8787
# Allowed browser origin for the web app (Vite dev server runs on 8080).
CORS_ORIGIN=http://localhost:8080

# ── Supabase (CareerCraft's project — used for auth verification + RLS reads) ─
# The MCP server NEVER holds model keys. It only reads/writes the interview &
# study domain tables, scoped to the calling user via their forwarded JWT.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: only for service-role maintenance tasks (not used on the hot path).
SUPABASE_SERVICE_ROLE_KEY=

# ── Model provider (the ONLY path to a model) ──────────────────────────────
# mock    → no external calls; deterministic canned inference (great for dev).
# http    → calls a real Horus deployment.
# gateway → calls an OpenAI-compatible chat-completions gateway directly
#           (the same gateway CareerCraft's interview-ai edge function uses).
#           This is the real, no-mock generation path.
# For CareerCraft local dev with the web app, use gateway + hn (see README "Run it with CareerCraft").
HORUS_MODE=mock
HORUS_TENANT=careercraft
HORUS_BASE_URL=
HORUS_API_KEY=
# Maps onto what Horus already exposes today (rag-metadata / graph-query).
HORUS_RAG_URL=
HORUS_GRAPH_URL=

# ── Gateway provider (used when HORUS_MODE=gateway) ─────────────────────────
# MODEL_GATEWAY_KEY is your existing LOVABLE_API_KEY (usable from Node).
MODEL_GATEWAY_URL=https://ai.gateway.lovable.dev/v1/chat/completions
MODEL_GATEWAY_KEY=
MODEL_FAST=google/gemini-2.5-flash
MODEL_DEEP=google/gemini-2.5-flash

# ── Grounding (the proof layer behind tips & resources) ─────────────────────
# hn   → REAL Hacker News (Algolia) sources — no API key needed. Recommended.
# mock → canned proven sources (dev only).
# http → a grounding bridge (Reddit MCP + web-search MCP + Horus RAG).
GROUNDING_MODE=hn
GROUNDING_BASE_URL=
GROUNDING_API_KEY=
